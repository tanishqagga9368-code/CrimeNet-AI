# ========================================================
# Frontend Production Environment Variables (Vercel Dashboard)
# ========================================================
# In Vercel Project Settings -> Environment Variables, configure:

# URL of your deployed Spring Boot backend (HTTPS required for production)
VITE_BACKEND_URL=https://your-backend-api.onrender.com

# URL of your deployed Python FastAPI AI Service (HTTPS required for production)
VITE_AI_URL=https://your-ai-service.onrender.com
