# ========================================================
# Backend Production Environment Variables (Spring Boot)
# ========================================================
# Deploy on a persistent server/container (e.g. Render, Railway, Cloud Run, AWS ECS/EC2)

# Port assigned by cloud provider (defaults to 8080)
PORT=8080

# PostgreSQL Connection (e.g. Supabase, Neon, AWS RDS, Render Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/criminal_network_intelligence
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# Neo4j Graph Database (e.g. Neo4j AuraDB or self-hosted)
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Internal / Public AI Service URL
AI_SERVICE_URL=https://your-ai-service.onrender.com

# JWT Secret Key (Use a strong 256-bit secret in production)
JWT_SECRET=SIH2026CriminalNetworkIntelligenceSecureJwtSecretKeyForDevelopmentOnly

# Allowed CORS Origins (comma-separated, include your production Vercel frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://crime-net-ai-1dsp.vercel.app
